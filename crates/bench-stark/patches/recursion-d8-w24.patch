+    )
+    .unwrap();
+    phase("prepared_batch_work.native_verify");
+    verify(&config, &air, &proof, &public).unwrap();
+    phase("prepared_batch_work.prepare");
+    let prepared = PreparedLayer::<Config, FibonacciAir, Backend, 8>::new(
+        PreparedSource::UniStark {
